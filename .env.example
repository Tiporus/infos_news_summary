# Anthropic API key (résumés IA neutres des stories)
ANTHROPIC_API_KEY=sk-ant-...

# Connection string Postgres (Supabase). Privilégier le pooler en runtime
# (port 6543, transaction mode) :
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.sdvcghtqrncimjhklzwg:CHANGEME@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Connexion directe — uniquement pour `prisma migrate` / `prisma db push`
# (pas pour le runtime). Format :
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# DIRECT_URL="postgresql://postgres:CHANGEME@db.sdvcghtqrncimjhklzwg.supabase.co:5432/postgres"

# Utilisé une seule fois par scripts/import-to-supabase.ts
# SUPABASE_DATABASE_URL="postgresql://postgres.sdvcghtqrncimjhklzwg:CHANGEME@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Secret partagé pour autoriser /api/cron/ingest
CRON_SECRET=changeme-please

# Optionnel : forcer le modèle Claude utilisé pour les résumés
# ANTHROPIC_MODEL=claude-haiku-4-5
