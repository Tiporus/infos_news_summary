// Prisma schema — agrégateur de news style Ground.news
// Migration : `npx prisma migrate dev`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct connection used during prisma migrate / db push when the runtime
  // url targets the transaction pooler (port 6543). Optional in dev.
  directUrl = env("DIRECT_URL")
}

model Source {
  id         String     @id
  name       String
  rssUrl     String
  homepage   String
  country    String
  language   String
  bias       String
  factuality String
  active     Boolean    @default(true)
  articles   Article[]
}

model Article {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  title       String
  url         String   @unique
  excerpt     String?
  imageUrl    String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  storyId     String?
  story       Story?   @relation(fields: [storyId], references: [id])

  @@index([publishedAt])
  @@index([storyId])
  @@index([sourceId])
}

model Story {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String?   // Tease court (2 phrases) — utilisé sur les cards
  synthesisPoints String?   // JSON array of bullet-point strings (synthèse structurée)
  viewLeft        String?   // Lecture par les sources de gauche
  viewRight       String?   // Lecture par les sources de droite
  imageUrl        String?   // Image illustrative (RSS thumbnail ou URL externe)
  articleCount    Int       @default(0) // dénormalisé, maintenu par trigger
  category        String
  region          String
  firstSeenAt     DateTime  @default(now())
  lastUpdatedAt   DateTime  @updatedAt
  articles        Article[]

  @@index([region, category])
  @@index([lastUpdatedAt])
  @@index([articleCount(sort: Desc), lastUpdatedAt(sort: Desc)])
}
